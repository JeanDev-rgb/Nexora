<Window x:Class="Nexora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Nexora.Desktop.Converters"
        xmlns:views="clr-namespace:Nexora.Desktop.Views"
        Title="NEXORA | Cyber Management" Height="860" Width="1420" MinHeight="650" MinWidth="1000" Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource BorderBrush}"/><Setter Property="Margin" Value="0,16"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom"><Separator/><TextBlock Text="APARIENCIA" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Bold"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Margin="0,8,0,0"/></StackPanel>
                <StackPanel>
                    <TextBlock Text="NEXORA" Foreground="{DynamicResource PrimaryHoverBrush}" FontSize="26" FontWeight="Bold"/><TextBlock Text="CYBER MANAGEMENT" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,28"/>
                    <TextBlock Text="OPERACIÓN" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource NavButton}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Style="{StaticResource NavButton}" Content="Estaciones" Command="{Binding NavigateCommand}" CommandParameter="Estaciones"/><Button Style="{StaticResource NavButton}" Content="Caja" Command="{Binding NavigateCommand}" CommandParameter="Caja"/><Button Style="{StaticResource NavButton}" Content="Historial" Command="{Binding NavigateCommand}" CommandParameter="Historial"/>
                    <Separator/><TextBlock Text="ADMINISTRACIÓN" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/><Button Style="{StaticResource NavButton}" Content="Configuración" Command="{Binding NavigateCommand}" CommandParameter="Configuración"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,24,30,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="{Binding CurrentSection}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Control operativo y financiero de tu cibercafé" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Sistema operativo" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <views:DashboardView Visibility="{Binding IsDashboard, Converter={StaticResource VisibleWhenTrue}}"/>
                    <views:StationsView Visibility="{Binding IsStations, Converter={StaticResource VisibleWhenTrue}}"/>
                    <views:CashView Visibility="{Binding IsCash, Converter={StaticResource VisibleWhenTrue}}"/>
                    <views:HistoryView Visibility="{Binding IsHistory, Converter={StaticResource VisibleWhenTrue}}"/>
                    <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource VisibleWhenTrue}}"/>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="1" Background="#660B1120" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="220"><ProgressBar IsIndeterminate="True" Height="5" Foreground="{DynamicResource PrimaryBrush}"/><TextBlock Text="Actualizando datos…" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="White" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" Padding="10,8" CornerRadius="6" Margin="0,14,0,0"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedTextBrush}"/></Border>
        </Grid>
    </Grid>
</Window>
