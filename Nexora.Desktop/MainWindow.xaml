<Window x:Class="Nexora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Nexora.Desktop.Converters"
        Title="NEXORA | Cyber Management" Height="820" Width="1280"
        Background="#0B1120">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <conv:SessionModeConverter x:Key="SessionModeConverter"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="Margin" Value="0,2"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="NEXORA" FontSize="30" FontWeight="Bold" Foreground="#60A5FA"/><TextBlock Text="CYBER MANAGEMENT" FontSize="12" Foreground="#94A3B8"/></StackPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18">
            <Border Background="#172033" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="EQUIPOS"/><TextBlock Text="{Binding TotalComputers}" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#172033" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="SESIONES ACTIVAS"/><TextBlock Text="{Binding ActiveSessions}" FontSize="28" Foreground="#34D399"/></StackPanel></Border>
            <Border Background="#172033" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="INGRESOS COBRADOS HOY"/><TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:C2}}" FontSize="28"/></StackPanel></Border>
            <Border Background="#172033" Padding="16"><StackPanel><TextBlock Text="ESTIMADO ACTIVO"/><TextBlock Text="{Binding ActiveEstimatedAmount, StringFormat={}{0:C2}}" FontSize="28" Foreground="#FBBF24"/></StackPanel></Border>
        </UniformGrid>
        <TabControl Grid.Row="2" Background="#111827" Foreground="White">
            <TabItem Header="ESTACIONES">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Width="240" Text="{Binding NewComputerName}"/><Button Content="Registrar equipo" Command="{Binding AddComputerCommand}"/><Button Content="Actualizar" Command="{Binding RefreshCommand}"/></StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Computers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="#172033" Width="300" Margin="0,0,12,12" Padding="14"><StackPanel>
                            <DockPanel><TextBlock Text="{Binding Name}" FontSize="18"/><TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="#60A5FA"/></DockPanel>
                            <TextBlock Text="{Binding SessionModeText}" Foreground="#A5B4FC"/><TextBlock Text="{Binding PaymentText}" Foreground="#94A3B8"/><TextBlock Text="{Binding SessionText}" Foreground="#FBBF24" Margin="0,8"/>
                            <ComboBox ItemsSource="{Binding Tariffs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedTariffId}" ToolTip="Tarifa"/>
                            <ComboBox ItemsSource="{Binding SessionModes}" SelectedItem="{Binding SelectedMode}" Margin="4"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SessionModeConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <ComboBox ItemsSource="{Binding ContractDurations}" SelectedItem="{Binding SelectedDurationMinutes}" ToolTip="Minutos contratados"/>
                            <TextBlock Text="{Binding ContractedAmount, StringFormat=Paquete: {0:C2}}" Foreground="#CBD5E1"/>
                            <CheckBox Content="Cobrar al iniciar" IsChecked="{Binding PayAtStart}" Foreground="White" Margin="4"/>
                            <Button Content="Iniciar sesión" Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhenTrue}}"/>
                            <Button Content="Finalizar / liberar" Command="{Binding DataContext.FinishSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsInUse, Converter={StaticResource VisibleWhenTrue}}"/>
                            <Button Content="Retirar / habilitar equipo" Command="{Binding DataContext.ToggleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="TARIFAS"><StackPanel Margin="18"><TextBlock Text="Nueva tarifa" FontSize="18"/><StackPanel Orientation="Horizontal"><TextBox Width="220" Text="{Binding NewTariffName}"/><TextBox Width="120" Text="{Binding NewTariffPrice}"/><Button Content="Guardar tarifa" Command="{Binding AddTariffCommand}"/></StackPanel><ListView ItemsSource="{Binding Tariffs}" Background="Transparent"><ListView.View><GridView><GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="250"/><GridViewColumn Header="Precio / hora" DisplayMemberBinding="{Binding PricePerHour, StringFormat={}{0:C2}}" Width="140"/><GridViewColumn Header="Activa" DisplayMemberBinding="{Binding IsActive}" Width="100"/></GridView></ListView.View></ListView></StackPanel></TabItem>
            <TabItem Header="HISTORIAL"><ScrollViewer Margin="18"><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#172033" Padding="10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ComputerName}"/><TextBlock Grid.Column="1" Text="{Binding Mode}"/><TextBlock Grid.Column="2" Text="{Binding StartedAtUtc, StringFormat={}{0:g}}"/><TextBlock Grid.Column="3" Text="{Binding Duration}"/><TextBlock Grid.Column="4" Text="{Binding PaymentStatus}"/><TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat={}{0:C2}}"/><Button Grid.Column="6" Content="Registrar cobro" Command="{Binding DataContext.RegisterPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPending, Converter={StaticResource VisibleWhenTrue}}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="#94A3B8" Margin="4,12"/>
    </Grid>
</Window>
