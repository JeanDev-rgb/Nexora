<Window x:Class="Nexora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Nexora.Desktop.Converters"
        Title="NEXORA | Cyber Management" Height="860" Width="1420" MinHeight="650" MinWidth="1000" Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <conv:SessionModeConverter x:Key="SessionModeConverter"/>
        <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource BorderBrush}"/><Setter Property="Margin" Value="0,16"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom"><Separator/><TextBlock Text="APARIENCIA" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Bold"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Margin="0,8,0,0"/></StackPanel>
                <StackPanel>
                    <TextBlock Text="NEXORA" Foreground="{DynamicResource PrimaryHoverBrush}" FontSize="26" FontWeight="Bold"/><TextBlock Text="CYBER MANAGEMENT" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,0,0,28"/>
                    <TextBlock Text="OPERACIÓN" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button Style="{StaticResource NavButton}" Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Style="{StaticResource NavButton}" Content="Estaciones" Command="{Binding NavigateCommand}" CommandParameter="Estaciones"/><Button Style="{StaticResource NavButton}" Content="Caja" Command="{Binding NavigateCommand}" CommandParameter="Caja"/><Button Style="{StaticResource NavButton}" Content="Historial" Command="{Binding NavigateCommand}" CommandParameter="Historial"/>
                    <Separator/><TextBlock Text="ADMINISTRACIÓN" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/><Button Style="{StaticResource NavButton}" Content="Configuración" Command="{Binding NavigateCommand}" CommandParameter="Configuración"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,24,30,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="{Binding CurrentSection}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Control operativo y financiero de tu cibercafé" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Sistema operativo" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Text="Resumen de hoy" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,0,0,14"/>
                        <UniformGrid Columns="4" Margin="0,0,0,6"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EQUIPOS TOTALES" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalComputers}" Style="{StaticResource MetricValue}"/><TextBlock Text="Registrados" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EQUIPOS LIBRES" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding AvailableComputers}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="Listos para iniciar" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EN USO" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveSessions}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource PrimaryHoverBrush}"/><TextBlock Text="Sesiones activas" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COBRADO HOY" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:C2}}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="Ingresos confirmados" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border></UniformGrid>
                        <UniformGrid Columns="3" Margin="0,0,0,16"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ESTIMACIÓN ACTIVA" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveEstimatedAmount, StringFormat={}{0:C2}}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="No es ingreso cobrado" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PAGOS PENDIENTES" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingPayments}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="Requieren confirmación" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FUERA DE SERVICIO" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding OutOfServiceComputers}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource DangerBrush}"/><TextBlock Text="Equipos retirados" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border></UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Acciones rápidas" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="Ver estaciones" Command="{Binding NavigateCommand}" CommandParameter="Estaciones"/><Button Content="Revisar caja" Command="{Binding NavigateCommand}" CommandParameter="Caja"/><Button Content="Ver historial" Command="{Binding NavigateCommand}" CommandParameter="Historial"/></WrapPanel></StackPanel></Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsStations, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox Width="210" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar estación"/><ComboBox Width="150" ItemsSource="{Binding StationFilters}" SelectedItem="{Binding StationFilter}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBox Width="220" Text="{Binding NewComputerName}" ToolTip="Nombre del equipo"/><Button Content="Registrar equipo" Command="{Binding AddComputerCommand}"/><Button Content="Actualizar" Command="{Binding RefreshCommand}"/></StackPanel></DockPanel>
                        <ItemsControl ItemsSource="{Binding VisibleComputers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="300"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{DynamicResource PrimaryHoverBrush}"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBox Width="190" Text="{Binding EditedName}"/><Button Content="Renombrar" Command="{Binding DataContext.RenameComputerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><TextBlock Text="{Binding SessionModeText}" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="{Binding PaymentText}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding SessionText}" Foreground="{DynamicResource WarningBrush}" Margin="0,10" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Tariffs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedTariffId}" ToolTip="Tarifa"/><ComboBox ItemsSource="{Binding SessionModes}" SelectedItem="{Binding SelectedMode}"/><ComboBox ItemsSource="{Binding ContractDurations}" SelectedItem="{Binding SelectedDurationMinutes}" ToolTip="Minutos contratados"/><TextBlock Text="{Binding ContractedAmount, StringFormat=Paquete: {0:C2}}" Foreground="{DynamicResource MutedTextBrush}"/><CheckBox Content="Cobrar al iniciar" IsChecked="{Binding PayAtStart}" Foreground="{DynamicResource TextBrush}" Margin="0,8"/><Button Content="Iniciar sesión" Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhenTrue}}"/><Button Content="Finalizar y liberar" Command="{Binding DataContext.FinishSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsInUse, Converter={StaticResource VisibleWhenTrue}}"/><Button Content="Retirar / habilitar" Command="{Binding DataContext.ToggleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsCash, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="Cobros confirmados y pendientes" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><ComboBox Width="150" ItemsSource="{Binding HistoryComputerOptions}" SelectedItem="{Binding HistoryComputerFilter}"/><ComboBox Width="130" ItemsSource="{Binding HistoryPaymentOptions}" SelectedItem="{Binding HistoryPaymentFilter}"/><DatePicker Width="135" SelectedDate="{Binding HistoryFromDate}"/><DatePicker Width="135" SelectedDate="{Binding HistoryToDate}"/></StackPanel><DataGrid ItemsSource="{Binding VisibleHistory}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Equipo" Binding="{Binding ComputerName}" Width="*"/><DataGridTextColumn Header="Concepto" Binding="{Binding TariffName}" Width="*"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding PaymentStatus}" Width="120"/><DataGridTemplateColumn Header="Acción" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Registrar cobro" Command="{Binding DataContext.RegisterPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPending, Converter={StaticResource VisibleWhenTrue}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel>
                    <StackPanel Visibility="{Binding IsHistory, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="Sesiones finalizadas" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><ComboBox Width="150" ItemsSource="{Binding HistoryComputerOptions}" SelectedItem="{Binding HistoryComputerFilter}"/><ComboBox Width="150" ItemsSource="{Binding HistoryModeOptions}" SelectedItem="{Binding HistoryModeFilter}"/><ComboBox Width="150" ItemsSource="{Binding HistoryStateOptions}" SelectedItem="{Binding HistoryStateFilter}"/><DatePicker Width="135" SelectedDate="{Binding HistoryFromDate}"/><DatePicker Width="135" SelectedDate="{Binding HistoryToDate}"/></StackPanel><DataGrid ItemsSource="{Binding VisibleHistory}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Equipo" Binding="{Binding ComputerName}" Width="*"/><DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="140"/><DataGridTextColumn Header="Inicio" Binding="{Binding StartedAtUtc, StringFormat={}{0:g}}" Width="150"/><DataGridTextColumn Header="Duración" Binding="{Binding Duration}" Width="130"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="120"/><DataGridTextColumn Header="Pago" Binding="{Binding PaymentStatus}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel>
                    <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="Configuración operativa" FontSize="18" FontWeight="SemiBold"/><Border Style="{StaticResource Card}" Margin="0,16,0,12"><StackPanel><TextBlock Text="Nueva tarifa" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBox Width="220" Text="{Binding NewTariffName}" ToolTip="Nombre"/><TextBox Width="130" Text="{Binding NewTariffPrice}" ToolTip="Precio por hora"/><Button Content="Guardar tarifa" Command="{Binding AddTariffCommand}"/></StackPanel></StackPanel></Border><DataGrid ItemsSource="{Binding Tariffs}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Precio / hora" Binding="{Binding PricePerHour, StringFormat={}{0:C2}}" Width="160"/><DataGridCheckBoxColumn Header="Activa" Binding="{Binding IsActive}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" Padding="10,8" CornerRadius="6" Margin="0,14,0,0"><TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedTextBrush}"/></Border>
        </Grid>
    </Grid>
</Window>
