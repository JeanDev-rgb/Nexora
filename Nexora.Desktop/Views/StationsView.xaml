<UserControl x:Class="Nexora.Desktop.Views.StationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexora.Desktop.Converters">
    <UserControl.Resources><conv:BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox Width="210" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar estación"/><ComboBox Width="150" ItemsSource="{Binding StationFilters}" SelectedItem="{Binding StationFilter}"/></StackPanel><StackPanel Orientation="Horizontal"><TextBox Width="220" Text="{Binding NewComputerName}" ToolTip="Nombre del equipo"/><Button Content="Registrar equipo" Command="{Binding AddComputerCommand}"/><Button Content="Actualizar" Command="{Binding RefreshCommand}"/></StackPanel></DockPanel>
        <ItemsControl ItemsSource="{Binding VisibleComputers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="300"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{DynamicResource PrimaryHoverBrush}"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBox Width="190" Text="{Binding EditedName}"/><Button Content="Renombrar" Command="{Binding DataContext.RenameComputerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><TextBlock Text="{Binding SessionModeText}" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="{Binding PaymentText}" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding SessionText}" Foreground="{DynamicResource WarningBrush}" Margin="0,10" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Tariffs}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedTariffId}" ToolTip="Tarifa"/><ComboBox ItemsSource="{Binding SessionModes}" SelectedItem="{Binding SelectedMode}"/><ComboBox ItemsSource="{Binding ContractDurations}" SelectedItem="{Binding SelectedDurationMinutes}" ToolTip="Minutos contratados"/><TextBlock Text="{Binding ContractedAmount, StringFormat=Paquete: {0:C2}}" Foreground="{DynamicResource MutedTextBrush}"/><CheckBox Content="Cobrar al iniciar" IsChecked="{Binding PayAtStart}" Foreground="{DynamicResource TextBrush}" Margin="0,8"/><Button Content="Iniciar sesión" Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhenTrue}}"/><Button Content="Finalizar y liberar" Command="{Binding DataContext.FinishSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsInUse, Converter={StaticResource VisibleWhenTrue}}"/><Button Content="Retirar / habilitar" Command="{Binding DataContext.ToggleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
</UserControl>
