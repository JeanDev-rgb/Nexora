<UserControl x:Class="Nexora.Desktop.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexora.Desktop.Converters"
             DataContext="{Binding Cash}">
    <UserControl.Resources><conv:BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Operaciones de caja. Los cobros se agrupan por la fecha efectiva del pago; las obligaciones pendientes usan su fecha de sesión." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><ComboBox Width="150" ItemsSource="{Binding ComputerOptions}" SelectedItem="{Binding ComputerFilter}"/><ComboBox Width="130" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding PaymentFilter}"/><DatePicker Width="135" SelectedDate="{Binding FromDate}"/><DatePicker Width="135" SelectedDate="{Binding ToDate}"/></StackPanel>
        <UniformGrid Columns="2" Margin="0,0,0,12"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COBROS CONFIRMADOS" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding ConfirmedTotal, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PENDIENTE DE COBRO" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding PendingTotal, StringFormat={}{0:C2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/></StackPanel></Border></UniformGrid>
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
        <DataGrid ItemsSource="{Binding VisibleEntries}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Equipo" Binding="{Binding ComputerName}" Width="*"/><DataGridTextColumn Header="Concepto" Binding="{Binding TariffName}" Width="*"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="120"/><DataGridTextColumn Header="Fecha efectiva local" Binding="{Binding CashDate, StringFormat={}{0:g}}" Width="160"/><DataGridTextColumn Header="Estado" Binding="{Binding PaymentStatusText}" Width="120"/><DataGridTemplateColumn Header="Acción" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Registrar cobro" Click="ConfirmPayment_Click" Visibility="{Binding IsPending, Converter={StaticResource VisibleWhenTrue}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    </StackPanel>
</UserControl>
