<UserControl x:Class="Nexora.Desktop.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexora.Desktop.Converters">
    <UserControl.Resources><conv:BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Cobros confirmados y pendientes" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><ComboBox Width="150" ItemsSource="{Binding HistoryComputerOptions}" SelectedItem="{Binding HistoryComputerFilter}"/><ComboBox Width="130" ItemsSource="{Binding HistoryPaymentOptions}" SelectedItem="{Binding HistoryPaymentFilter}"/><DatePicker Width="135" SelectedDate="{Binding HistoryFromDate}"/><DatePicker Width="135" SelectedDate="{Binding HistoryToDate}"/></StackPanel>
        <DataGrid ItemsSource="{Binding VisibleHistory}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Equipo" Binding="{Binding ComputerName}" Width="*"/><DataGridTextColumn Header="Concepto" Binding="{Binding TariffName}" Width="*"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding PaymentStatus}" Width="120"/><DataGridTemplateColumn Header="Acción" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Registrar cobro" Command="{Binding DataContext.RegisterPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPending, Converter={StaticResource VisibleWhenTrue}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    </StackPanel>
</UserControl>
