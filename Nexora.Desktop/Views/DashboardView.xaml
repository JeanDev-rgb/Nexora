<UserControl x:Class="Nexora.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Resumen de hoy" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,0,0,14"/>
        <UniformGrid Columns="4" Margin="0,0,0,6">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EQUIPOS TOTALES" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalComputers}" Style="{StaticResource MetricValue}"/><TextBlock Text="Registrados" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EQUIPOS LIBRES" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding AvailableComputers}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="Listos para iniciar" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EN USO" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveSessions}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource PrimaryHoverBrush}"/><TextBlock Text="Sesiones activas" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COBRADO HOY" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:C2}}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="Ingresos confirmados" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border>
        </UniformGrid>
        <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ESTIMACIÓN ACTIVA" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveEstimatedAmount, StringFormat={}{0:C2}}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="No es ingreso cobrado" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PAGOS PENDIENTES" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingPayments}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="Requieren confirmación" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FUERA DE SERVICIO" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding OutOfServiceComputers}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource DangerBrush}"/><TextBlock Text="Equipos retirados" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Acciones rápidas" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,0"><Button Content="Ver estaciones" Command="{Binding NavigateCommand}" CommandParameter="Estaciones"/><Button Content="Revisar caja" Command="{Binding NavigateCommand}" CommandParameter="Caja"/><Button Content="Ver historial" Command="{Binding NavigateCommand}" CommandParameter="Historial"/></WrapPanel></StackPanel></Border>
    </StackPanel>
</UserControl>
